{
  "appId": "br.com.oneagro.monitor",
  "appName": "OneAgro Monitor",
  "webDir": "www",
  "appendUserAgent": "OneAgroApp",
  "backgroundColor": "#f4f6f4",
  "server": {
    "url": "https://oneagroapp.com.br/app",
    "errorPath": "offline.html",
    "allowNavigation": [
      "oneagroapp.com.br",
      "www.oneagroapp.com.br",
      "monitoresporos-production.up.railway.app"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true
  }
}
